# Copy this file to .env.local and fill in your own values.
# Required in Vercel: Project Settings -> Environment Variables (Production, Preview, Development).

# Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Dashboard -> Project Settings -> API -> anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical site origin, no trailing slash (falls back to VERCEL_URL then localhost)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Never add the service-role key here. It must not be exposed to the browser,
# and the app does not use it.
